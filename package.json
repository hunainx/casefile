{
  "name": "casefile",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "trace:extract": "python3 traceability/extract.py docs/PRD.md",
    "trace:report": "tsx traceability/report.ts",
    "guardrails": "vitest run --config guardrails/vitest.config.ts",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:up": "bash scripts/dev-db.sh up",
    "db:down": "bash scripts/dev-db.sh down",
    "db:reset": "bash scripts/dev-db.sh reset",
    "bench": "tsx benchmarks/run.ts",
    "bench:ingest-baseline": "bash benchmarks/ingest-baseline/run-baseline.sh",
    "doneness": "tsx traceability/doneness.ts",
    "audit:verification": "tsx traceability/audit.ts",
    "ingest:bootstrap": "tsx tools/ingest-cli/src/bootstrap.ts",
    "ingest": "tsx tools/ingest-cli/src/ingest.ts",
    "ingest:status": "tsx tools/ingest-cli/src/status.ts",
    "ingest:worker": "tsx tools/ingest-cli/src/worker.ts",
    "ingest:resume": "tsx tools/ingest-cli/src/resume.ts",
    "ingest:retry": "tsx tools/ingest-cli/src/retry.ts",
    "ingest:report": "tsx tools/ingest-cli/src/report.ts",
    "ingest:include": "tsx tools/ingest-cli/src/include.ts",
    "fake-corpus": "tsx tools/fake-corpus/src/cli.ts",
    "matter:check": "tsx scripts/matter-check.ts",
    "matter:preflight": "tsx scripts/matter-preflight.ts",
    "new-matter": "tsx scripts/new-matter.ts",
    "admin:reset-link": "tsx scripts/issue-password-reset.ts",
    "admin:add-user": "tsx scripts/admin-add-user.ts",
    "start": "tsx apps/api/src/server.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm guardrails && pnpm audit:verification && pnpm trace:report"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/autocannon": "^7.12.7",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.0",
    "@types/word-extractor": "^1.0.6",
    "autocannon": "^8.0.0",
    "eslint": "^10.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "yaml": "^2.6.1"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.0.1",
    "@kenjiuno/msgreader": "^1.28.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@simplewebauthn/server": "^13.3.3",
    "adm-zip": "^0.6.1",
    "html-to-text": "^10.0.1",
    "long": "5.3.2",
    "mailparser": "^3.9.32",
    "mammoth": "^1.12.2",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "pst-extractor": "1.12.0",
    "word-extractor": "^1.0.4",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  }
}
