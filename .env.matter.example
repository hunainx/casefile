# ==============================================================================
# CASEFILE MATTER CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the values for your deployed matter.
# ==============================================================================

# Database Connection Strings
# DATABASE_URL: Unprivileged runtime application connection (casefile_app)
DATABASE_URL=postgresql://casefile_app.<SUPABASE_PROJECT_REF>:<PASSWORD>@aws-0-<SUPABASE_REGION>.pooler.supabase.com:5432/postgres

# DATABASE_URL_MIGRATIONS: Owner connection for migrations/schema updates ONLY (local/CI)
# NEVER put this secret on Cloud Run services or runtime Secret Manager keys.
DATABASE_URL_MIGRATIONS=postgresql://postgres.<SUPABASE_PROJECT_REF>:<OWNER_PASSWORD>@aws-0-<SUPABASE_REGION>.pooler.supabase.com:5432/postgres

# Supabase Project Ref
SUPABASE_PROJECT_REF=<SUPABASE_PROJECT_REF>

# Google Cloud & Storage Configuration
GCP_PROJECT_ID=<GCP_PROJECT_ID>
GCP_REGION=<GCP_REGION>
SUPABASE_REGION=<SUPABASE_REGION>
GCS_SERVICE_ACCOUNT_EMAIL=casefile-<MATTER_SLUG>-sa@<GCP_PROJECT_ID>.iam.gserviceaccount.com
GCS_BUCKET_SOURCES=casefile-<MATTER_SLUG>-sources
GCS_BUCKET_ARTIFACTS=casefile-<MATTER_SLUG>-artifacts
GCS_BUCKET_EXPORTS=casefile-<MATTER_SLUG>-exports
STORAGE_DRIVER=gcs

# Key-file fallback (ONLY needed if keyless IAM impersonation is unavailable):
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/key.json (must be in scratch/ or outside repo, never committed)

# Matter Deployment Identity Binding (PRD §40 / Decision D59)
# MATTER_TENANT_ID: Root organization / tenant UUID provisioned for this matter deployment.
MATTER_TENANT_ID=00000000-0000-0000-0000-000000000000

# MATTER_INVESTIGATION_ID: Default investigation UUID provisioned for this matter deployment.
MATTER_INVESTIGATION_ID=00000000-0000-0000-0000-000000000000

# /mcp sign-in (D69, D73): Claude connects with each person's own Casefile account (OAuth,
# password + TOTP). There is no shared MCP token. scripts/deploy-matter.ts sets MCP_PUBLIC_URL.

# JWT Signing Secret (REQUIRED — no default, minimum 32 characters)
# HMAC key for every access token the API signs and verifies. The API refuses to start
# without it (apps/api/src/config/required-secrets.ts). Must be the exact value stored in
# this matter's Secret Manager secret (matterConfig.secrets.jwtSecret, created once by
# deploy-matter.ts --phase=database and mounted on Cloud Run): bootstrap.ts signs operator
# tokens locally with this value, and a mismatch makes them fail against the API.
JWT_SECRET=<VALUE_OF_SECRET_MANAGER_JWT_SECRET>

# API Gateway URL (your deployed Cloud Run service URL, or a local service)
CASEFILE_API_URL=<CASEFILE_API_URL>

# NOTE ON INGESTION AND CLI TOKENS:
# The ingest CLI (tools/ingest-cli) authenticates using administrative credentials or
# acquires a fresh short-lived JWT (15-minute expiration) directly at run time.
# Short-lived JWTs must never be hardcoded into permanent MCP configurations.
