node_modules/
dist/
.turbo/
*.tsbuildinfo
.env
.env.*
!.env.matter.example
!.env.example
!.env.local.example
mcp-config/*.json
!mcp-config/.gitkeep
*.tmp
*.broken.tmp
__pycache__/
.venv/
.pytest_cache/
.pgdata/
.pglogs/
coverage/
playwright-report/
test-results/
scratch/
sandbox/
!sandbox/parser/.gitkeep
evals/corpora/**/*.generated/
.DS_Store

# Synthetic evaluation material is regenerable and deterministic: the manifest records
# the generator version, the seed, and the corpus SHA-256, so `generate_gold.py --seed N`
# reproduces it byte-identically. Keeping 500 generated files in version control would
# add 2MB of churn per regeneration and prove nothing the manifest does not already prove.
# Real design-partner documents and hand-corrected labels ARE committed when they arrive —
# they are not regenerable, and that is the whole difference.
evals/corpora/gold/documents/*.txt
evals/corpora/gold/labels.jsonl

# Guardrail run state — regenerated by every `pnpm guardrails` run and read by
# `pnpm trace:report`. CI passes it between jobs as a build artifact, not via git.
guardrails/.last-run.json
supabase/.temp/


# FINAL: local data that must never be committed. Test runs write their temporary files here (the tests remove
# them; a failed run can leave some behind).
.tmp-test-fixtures/
# Before/after captures and measurement output (they are kept outside the repository, in *-capture folders).
*-capture/
captures/
# Fake corpora (pnpm fake-corpus writes outside the repository by default; guardrails/no-fake-corpus-in-repo
# refuses a generated corpus inside it). Real case documents never belong anywhere near a repository.
fake-data/
casefile-fake-data/
fake-corpus-manifest.csv
fake-corpus-summary.json
# Local database dumps.
*.dump
*.sql.gz
*.pgdump
