# MCP sign-in (D69). Full, canonical HTTPS URL of /mcp as users add it to Claude (lowercase
# host, no trailing slash). The API refuses to start without it. FAKE example value:
MCP_PUBLIC_URL=https://mcp.example.com/mcp
# Optional: comma-separated Client ID Metadata Document URLs allowed to sign in. Empty means
# Claude Code only (https://claude.ai/oauth/claude-code-client-metadata).
MCP_OAUTH_TRUSTED_CLIENTS=
