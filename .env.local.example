# Local Docker development and test environment
DATABASE_URL=postgres://casefile:casefile@127.0.0.1:55432/casefile
DATABASE_URL_MIGRATIONS=postgres://casefile:casefile@127.0.0.1:55432/casefile
DATABASE_URL_TEST=postgres://casefile_app:casefile_app@127.0.0.1:55432/casefile_test

SUPABASE_PROJECT_REF=local
CASEFILE_API_URL=http://127.0.0.1:3000

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=local-dev-publishable-key

GCP_PROJECT_ID=local-casefile-project
GCP_REGION=europe-west2
SUPABASE_REGION=eu-west-2
GCS_SERVICE_ACCOUNT_EMAIL=local-service-account@local-casefile-project.iam.gserviceaccount.com
GCS_BUCKET_SOURCES=casefile-local-sources
GCS_BUCKET_ARTIFACTS=casefile-local-artifacts
GCS_BUCKET_EXPORTS=casefile-local-exports

STORAGE_DRIVER=memory
AI_PROVIDER=mock
AI_MOCK_SCRIPT=packages/mock-provider/scripts/default.json
REDIS_URL=redis://127.0.0.1:6379
LOG_LEVEL=info

CASEFILE_TENANT_ID=00000000-0000-0000-0000-000000000000
CASEFILE_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
CASEFILE_INVESTIGATION_ID=00000000-0000-0000-0000-000000000000
MATTER_TENANT_ID=00000000-0000-0000-0000-000000000000
MATTER_INVESTIGATION_ID=00000000-0000-0000-0000-000000000000
MCP_PUBLIC_URL=https://mcp.casefile.test/mcp
# /mcp without sign-in, for this computer only (D77). The API refuses to start this way unless
# HOST is 127.0.0.1/::1/localhost, MCP_PUBLIC_URL is unset or loopback, NODE_ENV is not
# production, and MCP_LOCAL_USER_ID is an active, MCP-eligible user of MATTER_TENANT_ID.
# The stdio CLI (packages/mcp/src/cli.ts) also runs as MCP_LOCAL_USER_ID.
# MCP_AUTH_MODE=local-no-login
# MCP_LOCAL_USER_ID=<uuid of your Casefile user>
JWT_SECRET=test_jwt_secret_at_least_32_bytes_long_000
CASEFILE_TOKEN=local_casefile_dev_token
